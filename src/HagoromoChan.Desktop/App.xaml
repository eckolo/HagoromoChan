<Application x:Class="HagoromoChan.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#171C24" />
        <SolidColorBrush x:Key="PanelBackground" Color="#222B37" />
        <SolidColorBrush x:Key="MainForeground" Color="#F0F3F7" />
        <SolidColorBrush x:Key="MutedForeground" Color="#B6C1D0" />
        <SolidColorBrush x:Key="Accent" Color="#A8D9C6" />
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#112C24" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
