<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <SolidColorBrush x:Key="WindowBackground" Color="#171C24" />
    <SolidColorBrush x:Key="PanelBackground" Color="#222B37" />
    <SolidColorBrush x:Key="MainForeground" Color="#F0F3F7" />
    <SolidColorBrush x:Key="MutedForeground" Color="#B6C1D0" />
    <SolidColorBrush x:Key="Accent" Color="#A8D9C6" />
    <!-- Button and RepeatButton share this chrome. In particular, the
         system theme must not replace a disabled arrow with a white rectangle. -->
    <ControlTemplate x:Key="OverlayButtonTemplate" TargetType="{x:Type primitives:ButtonBase}">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"
                SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Content" RecognizesAccessKey="True"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.70" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.40" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="#112C24" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
</ResourceDictionary>
