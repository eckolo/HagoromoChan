<Window x:Class="HagoromoChan.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="羽衣ちゃん" Width="177" Height="260"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Topmost="True" UseLayoutRounding="True"
        FontFamily="Yu Gothic UI, Meiryo" FontSize="14">
    <Grid x:Name="MascotSurface" Cursor="Hand"
          AutomationProperties.Name="羽衣ちゃん。クリックで会話、ドラッグで移動、右クリックで設定">
        <!-- Keep the resting silhouette hittable when a frame lifts the feet. -->
        <Image x:Name="RestingSilhouette" Stretch="Uniform" StretchDirection="DownOnly" Opacity="0.005" />
        <Image x:Name="MascotImage" Stretch="Uniform" StretchDirection="DownOnly"
               RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
</Window>
